{
  "name": "english-learning-backend",
  "version": "0.1.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only server.ts",
    "seed": "ts-node-dev --transpile-only seed.ts",
    "seed:grammar": "ts-node-dev --transpile-only seed_grammar_extra.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.1",
    "fluent-ffmpeg": "^2.1.3",
    "google-tts-api": "^2.0.2",
    "gtts": "^0.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.0",
    "multer": "^2.1.1",
    "openai": "^6.32.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mongodb": "^4.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
